  <header><div class="avatar" id="av"></div><div class="hd"><h1 id="title"></h1><p id="members"></p></div></header>
  <main id="chat"></main>
</div>
<script>
const D = __DATA__;
const START = D.start ? Date.parse(D.start) : null;
const hm = ms => new Date(ms).toLocaleTimeString("it-IT",{hour:"2-digit",minute:"2-digit"});
const hms = ms => new Date(ms).toLocaleTimeString("it-IT",{hour:"2-digit",minute:"2-digit",second:"2-digit"});
const off = s => { s = Math.floor(s); const h = Math.floor(s/3600), m = Math.floor(s/60)%60, x = String(s%60).padStart(2,"0");
  return h ? `${h}:${String(m).padStart(2,"0")}:${x}` : `${m}:${x}`; };
const el = (tag, cls, txt) => { const e = document.createElement(tag); if (cls) e.className = cls; if (txt != null) e.textContent = txt; return e; };

document.getElementById("title").textContent = D.title;
document.getElementById("av").textContent = D.title.replace(/[^\p{L}\p{N}]/gu,"").slice(0,3).toUpperCase();
document.getElementById("members").textContent = Object.keys(D.people).join(", ");
const chat = document.getElementById("chat");
if (START) {
  chat.append(el("div","chip", new Date(START).toLocaleDateString("it-IT",{day:"numeric",month:"long",year:"numeric"})));
  chat.append(el("div","sys", `Registrazione avviata alle ${hms(START)} · ${D.msgs.length} messaggi trascritti`));
}
let prev = null, lastT = -1e9;
for (const m of D.msgs) {
  const first = m.who !== prev || m.t - lastT > 300;
  const b = el("div","msg" + (first ? " first" : ""));
  if (first) { const w = el("div","who", m.who); w.style.color = `var(${D.people[m.who]})`; b.append(w); }
  const meta = el("span","meta");
  if (START) meta.append(el("span", null, off(m.t) + " · "), hm(START + m.t*1000)); else meta.append(off(m.t));
  const t = el("div","txt"); t.append(meta, document.createTextNode(m.text));
  b.append(t); chat.append(b); prev = m.who; lastT = m.t;
}
const counts = {}; D.msgs.forEach(m => counts[m.who] = (counts[m.who]||0) + 1);
const lg = el("div","legend");
for (const [p,c] of Object.entries(D.people)) { const s = el("span"); const n = el("b", null, p); n.style.color = `var(${c})`; s.append(n, ` ${counts[p]||0} msg`); lg.append(s); }
chat.append(lg);
</script></body></html>
"""


def write_html(path, info, msgs, speakers):
    data = {
        "title": info["title"],
        "start": info["start"].isoformat() if info["start"] else None,
        "people": {s: PALETTE[i % len(PALETTE)] for i, s in enumerate(speakers)},
        "msgs": msgs,
    }
    js = json.dumps(data, ensure_ascii=False).replace("</", "<\\/")
    out = TEMPLATE.replace("__TITLE__", html.escape(info["title"])).replace("__DATA__", js)
    open(path, "w", encoding="utf-8").write(out)


def main():
    ap = argparse.ArgumentParser(description="Registrazione Craig → chat in stile WhatsApp")
    ap.add_argument("input", help="cartella o file .zip scaricato da Craig")
    ap.add_argument("-o", "--out", help="cartella di uscita (default: la cartella di input, o accanto allo zip)")
    ap.add_argument("--model", default="large-v3", help="modello Whisper: tiny, base, small, medium, large-v3 (default)")
    ap.add_argument("--lang", default="it", help="lingua parlata (default: it)")
    ap.add_argument("--rename", action="append", default=[], metavar="VECCHIO=NUOVO", help="rinomina un parlante")
    ap.add_argument("--skip", action="append", default=[], metavar="NOME", help="ignora una traccia (es. un bot musicale)")
    ap.add_argument("--threads", type=int, default=os.cpu_count() or 4)
    a = ap.parse_args()

    tmp = None
    folder = a.input
    if zipfile.is_zipfile(a.input):
        tmp = tempfile.TemporaryDirectory(prefix="craig2chat-")
        with zipfile.ZipFile(a.input) as z:
            z.extractall(tmp.name)
        folder = tmp.name
        default_out = os.path.splitext(os.path.abspath(a.input))[0] + "-chat"
    elif os.path.isdir(a.input):
        default_out = a.input
    else:
        sys.exit(f"errore: {a.input} non è né una cartella né uno zip")

    renames = dict(r.split("=", 1) for r in a.rename)
    files = []
    for root, _, names in os.walk(folder):
        for n in sorted(names):
            if os.path.splitext(n)[1].lower() in AUDIO_EXT:
                who = speaker_name(n)
                if who in a.skip:
                    continue
                files.append((os.path.join(root, n), renames.get(who, who)))
    if not files:
        sys.exit(f"errore: nessuna traccia audio trovata in {a.input}")

    info = read_info(folder)
    print(f"{len(files)} tracce, modello {a.model}", file=sys.stderr)
    msgs = build_messages(transcribe(files, a.model, a.lang, a.threads))

    out = a.out or default_out
    os.makedirs(out, exist_ok=True)
    speakers = list(dict.fromkeys(w for _, w in files))
    write_html(os.path.join(out, "chat.html"), info, msgs, speakers)
    write_txt(os.path.join(out, "chat.txt"), info, msgs)
    print(f"fatto: {os.path.join(out, 'chat.html')}\n       {os.path.join(out, 'chat.txt')}", file=sys.stderr)


if __name__ == "__main__":
    main()
