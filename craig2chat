  --sys:#fdf3c4; --sys-fg:#5b5230; --line:#d9d2c6; --accent:#0f8a6c;
  --n1:#c2410c; --n2:#1d6fb8; --n3:#9333b5; --n4:#0f766e; --n5:#be185d; --n6:#a16207;
  --font:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif; color-scheme:light;
}
