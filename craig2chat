  --sys:#2a2716; --sys-fg:#e3d79c; --line:#25332f; --accent:#3fcf9f;
  --n1:#fb923c; --n2:#60a5fa; --n3:#d08cf0; --n4:#2dd4bf; --n5:#f472b6; --n6:#facc15; color-scheme:dark}}
